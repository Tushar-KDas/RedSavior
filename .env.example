# RedSavior Nationwide Blood Donation Platform Environment Configuration

# Public Supabase Client Config (Required for browser authentication and client queries)
NEXT_PUBLIC_SUPABASE_URL=https://mock-or-actual-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.mock_anon_key_for_local_development

# Supabase Server Service Role (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE IN NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=mock_service_role_key_for_admin_operations

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Map Tiles (OpenStreetMap default or custom Carto/MapLibre tiles)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Default Platform Timezone & Country
NEXT_PUBLIC_DEFAULT_LOCALE=bn
NEXT_PUBLIC_TIMEZONE=Asia/Dhaka
